# Environment & Secret configuration files (NEVER commit to git)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env
frontend/.env
!.env.example
!backend/.env.example
!frontend/.env.example

# Node.js & Frontend dependencies
node_modules/
frontend/node_modules/
dist/
frontend/dist/
.vite/
frontend/.vite/

# Python & Backend virtual environments
venv/
backend/venv/
__pycache__/
backend/__pycache__/
backend/routes/__pycache__/
*.py[cod]
*$py.class
*.so
.pytest_cache/

# User uploaded media in backend
backend/uploads/*
!backend/uploads/.gitkeep

# Logs & temp files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS artifacts
.DS_Store
Thumbs.db
.idea/
.vscode/

